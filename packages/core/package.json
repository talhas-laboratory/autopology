{
  "name": "@autopology/core",
  "version": "1.0.1",
  "description": "Core types, config, IDs, caching, and security helpers for AuTopology",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/talhas-laboratory/autology.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  }
}
