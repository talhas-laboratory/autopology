{
  "name": "@autopology/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server implementation for AuTopology",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/talhas-laboratory/autology.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@autopology/core": "1.0.0",
    "@autopology/storage-neo4j": "1.0.0",
    "@autopology/runtime-hooks": "1.0.0"
  }
}
